# Copy to .env. Never commit the real file.
NODE_ENV=production
PORT=8080
TRUST_PROXY=1

# Connect as utilities_app (it cannot bypass row-level security). Migrations use the owner account.
DATABASE_URL=postgres://utilities_app:CHANGE_ME@db:5432/utilities
OWNER_DATABASE_URL=postgres://utilities_owner:CHANGE_ME@db:5432/utilities
APP_DB_PASSWORD=CHANGE_ME

# Email (any HTTPS email API that accepts a JSON POST with bearer auth)
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=utilities@your-city.gov

# Stripe. The key must belong to the CITY's own Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional single sign-on with any OpenID Connect provider (Microsoft Entra, Google Workspace, Okta, ...).
# It only signs in people who already have an account here. Leave empty to turn it off.
# Redirect address to register with the provider: https://YOUR-HOST/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=work account
