# Copy to .env. Never commit the real file.
NODE_ENV=production
PORT=8080
# 1 only behind a reverse proxy such as Caddy or nginx (it then trusts the proxy's X-Forwarded-* headers).
TRUST_PROXY=1

# Two database passwords. The compose files build the connection addresses from them.
# The owner creates tables and runs migrations; the app connects as the limited utilities_app role (row security).
# The app refuses to start in production if it finds itself connected as the owner.
DB_OWNER_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
# Which published release to run (docker-compose.auto-update.yml). Change it, then "docker compose up -d" again.
APP_VERSION=
# Only when running the app outside the compose files. Leave both unset and the setup page asks for the
# connection on first start and keeps it in CONFIG_DIR/database.json (default ./config, /app/config in the image).
# Any variable here may also be given as NAME_FILE=/run/secrets/name (Docker and Kubernetes secrets).
# DATABASE_URL=postgres://utilities_app:APP_DB_PASSWORD@db:5432/utilities
# OWNER_DATABASE_URL=postgres://utilities_owner:DB_OWNER_PASSWORD@db:5432/utilities
# CONFIG_DIR=/app/config
# SETUP_TOKEN=   # fixes the setup code instead of printing a random one (scripted installs)

# Email: an HTTPS API that accepts POST {from, to, subject, text} as JSON with "Authorization: Bearer <token>"
# (Resend works as is; the deploy/mail-relay worker shows how to adapt another provider). https:// only.
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=utilities@your-city.gov

# Stripe. The key must belong to the CITY's own Stripe account.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional single sign-on with any OpenID Connect provider (Microsoft Entra, Google Workspace, Okta, ...).
# It only signs in people who already have an account here. Leave empty to turn it off.
# Redirect address to register with the provider: https://YOUR-HOST/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=work account

# Hosted demo only: allow the console email and fake payment processor in production. See deploy/README.md.
ALLOW_DEMO_ADAPTERS=
